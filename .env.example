# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side ONLY, never expose to client, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ────────────────────────────────────────────
# 32-byte (64 hex char) key for AES-256-GCM broker API key encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Aria — AI Advisor (Sprint 12+) ────────────────────────
# Powers POST /api/aria/chat. Gated to Pro/Elite tier in-app, but the
# route will 500 without this set regardless of tier.
ANTHROPIC_API_KEY=

# ── FastAPI Microservice (Sprint 3+) ─────────────────────
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_API_KEY=

# ── Redis / Upstash (Sprint 5+) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email — Resend (Sprint 7+) ───────────────────────────
RESEND_API_KEY=

# ── Payments (Sprint 8+) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (Dashboard > Product catalog) for the Pro/Elite plans —
# never hardcode these, checkout always reads them from here.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack Plan Codes (Dashboard > Plans) for the Pro/Elite plans — same
# rule, never hardcode these.
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ELITE=

# ── Monitoring (Sprint 9+) ────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
