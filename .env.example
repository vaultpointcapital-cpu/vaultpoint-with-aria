# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's already in .gitignore.

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-side ONLY, never expose to client, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ────────────────────────────────────────────
# 32-byte (64 hex char) key for AES-256-GCM broker API key encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Aria — AI Advisor (Sprint 12+) ────────────────────────
# Powers POST /api/aria/chat. Gated to Pro/Elite tier in-app, but the
# route will 500 without this set regardless of tier.
ANTHROPIC_API_KEY=

# ── FastAPI Microservice (Sprint 3+) ─────────────────────
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_API_KEY=

# ── Redis / Upstash ───────────────────────────────────────
# Used by the Python broker-sync service always; used here in the
# Next.js app for rate limiting (src/lib/rate-limit) as of the
# production-readiness pass — same Upstash instance, both services.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email — Resend (Sprint 7+) ───────────────────────────
RESEND_API_KEY=

# ── Payments (Sprint 8+) ──────────────────────────────────
# WARNING confirmed by the production-readiness env audit: there is no
# code-level separation between Stripe/Paystack TEST and LIVE keys —
# each var name holds whichever key matches the deployment target, with
# correctness resting entirely on what's pasted into each Vercel
# environment's dashboard (Production vs Preview/Development). Nothing
# in this codebase checks or warns if a live key ends up in Preview, or
# vice versa. Treat setting these per-environment in Vercel as
# security-critical, not routine config.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Declared but not currently read anywhere in src/ — no client-side
# Stripe.js/Elements integration exists yet (checkout redirects to a
# Stripe-hosted page). Keep or remove once that's decided; not a bug
# today, just unused.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Price IDs (Dashboard > Product catalog) for the Pro/Elite plans —
# never hardcode these, checkout always reads them from here.
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
PAYSTACK_SECRET_KEY=
# Same "declared but unused" note as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY above.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paystack Plan Codes (Dashboard > Plans) for the Pro/Elite plans — same
# rule, never hardcode these.
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_ELITE=
# Flutterwave — covers African markets outside Nigeria (see
# FLUTTERWAVE_COUNTRIES in src/lib/billing/routing.ts), not a Paystack
# fallback within Nigeria. Payment Plan ids (Dashboard > Payment Plans),
# same never-hardcode rule. FLUTTERWAVE_WEBHOOK_SECRET_HASH is the static
# secret string configured in Flutterwave Dashboard > Settings > Webhooks
# (compared directly against the verif-hash header — NOT an HMAC key).
# The webhook handler (src/app/api/webhooks/flutterwave/route.ts) has
# NOT been verified against a real Flutterwave webhook delivery — only
# against the documented example payload and empirical testing of the
# payment-plans/payments API. Verify with a real test delivery before
# launch.
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_PLAN_PRO=
FLUTTERWAVE_PLAN_ELITE=

# ── KYC (Managed Accounts, World B — see docs/managed-accounts/03-kyc-verification.md) ──
# Not wired to any real vendor call yet — only the webhook signature
# verification and the schema/gate plumbing exist so far. Both secrets'
# exact schemes are unconfirmed against live vendor docs (see
# src/lib/kyc/onfido.ts and src/lib/kyc/verifyme.ts) — do not treat
# setting these as "ready for real client PII."
ONFIDO_WEBHOOK_TOKEN=
VERIFYME_WEBHOOK_SECRET=

# ── Monitoring ────────────────────────────────────────────
# Client DSNs are not secret (safe in a public bundle) — this is the one
# Sentry var actually required for error capture to activate at all
# (src/instrumentation.ts / src/instrumentation-client.ts both read it;
# an empty value is a documented no-op, not a crash).
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only used at BUILD time for source-map upload
# (next.config.js's withSentryConfig). Safe to leave unset; the build
# just skips the upload step. Needs a real Sentry project to exist first.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Cron ──────────────────────────────────────────────────
# Bearer-auth secret for Vercel Cron-triggered routes
# (src/app/api/billing/profit-share/run) — generate with
# `openssl rand -hex 32`. Was missing from this file entirely; the route
# 500s without it.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
