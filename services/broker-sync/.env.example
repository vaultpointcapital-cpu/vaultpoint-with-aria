# Copy to .env and fill in real values. Never commit .env.

# ── Supabase (service-role — bypasses RLS, server-side only) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ────────────────────────────────────────────────
# Must be the EXACT same value as the Next.js app's ENCRYPTION_KEY —
# this service decrypts what that app encrypted. A mismatch here
# doesn't error at startup, it just fails every decrypt at sync time.
ENCRYPTION_KEY=

# ── Redis / Upstash (REST API, not the TCP protocol) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth for the /sync endpoint ──────────────────────────────────
# Must match PYTHON_SERVICE_API_KEY in the Next.js app's .env — that's
# the only caller allowed to trigger a manual sync.
PYTHON_SERVICE_API_KEY=

# ── MetaApi (MetaTrader 4/5 bridge) ──────────────────────────────
# Service-level token for VaultPoint's own MetaApi account — NOT a
# per-user credential. Only needed once a metatrader broker_connections
# row exists; get one from https://app.metaapi.cloud/api-access/token
METAAPI_TOKEN=
