# Copy to .env and fill in real values. Never commit .env.

# ── Supabase (service-role — bypasses RLS, server-side only) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Encryption ────────────────────────────────────────────────
# Must be the EXACT same value as the Next.js app's ENCRYPTION_KEY —
# this service decrypts what that app encrypted. A mismatch here
# doesn't error at startup, it just fails every decrypt at sync time.
ENCRYPTION_KEY=

# ── Redis / Upstash (REST API, not the TCP protocol) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Auth for the /sync endpoint ──────────────────────────────────
# Must match PYTHON_SERVICE_API_KEY in the Next.js app's .env — that's
# the only caller allowed to trigger a manual sync.
PYTHON_SERVICE_API_KEY=

# ── MetaApi (MetaTrader 4/5 bridge) ──────────────────────────────
# Service-level token for VaultPoint's own MetaApi account — NOT a
# per-user credential. Only needed once a metatrader broker_connections
# row exists; get one from https://app.metaapi.cloud/api-access/token
METAAPI_TOKEN=

# ── Observability ─────────────────────────────────────────────────
# Sentry DSN for error reporting. Optional — leave unset to disable
# Sentry entirely (local dev doesn't need it). Get one from your
# Sentry project's Settings > Client Keys.
SENTRY_DSN=

# ── Scheduler tuning (all optional, defaults shown) ───────────────
# How often the scheduler polls every broker_connections row, in seconds.
POLL_INTERVAL_SECONDS=60
# How long a cached balance/position read is served before the next poll
# refreshes it, in seconds. Should stay just under POLL_INTERVAL_SECONDS.
CACHE_TTL_SECONDS=55
# Minimum gap between two manual POST /sync/{user_id} calls for the same
# user, in seconds — protects broker rate limits from being hammered by
# repeated manual refresh clicks.
SYNC_RATE_LIMIT_SECONDS=60

# ── Alert Engine ───────────────────────────────────────────────────
# Resend API key for alert emails. Optional — alerts still fire and
# deliver in-app without it, just no email leg. Get one from
# https://resend.com/api-keys
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (see the deployment
# workstream's DNS records) — an unverified sender bounces or lands in
# spam. e.g. alerts@mail.yourdomain.com
ALERT_EMAIL_FROM=
# Base URL used to build the "view in app" link in alert emails.
APP_BASE_URL=http://localhost:3000
# Hours before the same alert can fire again while its condition stays
# true — prevents spamming on a value hovering near the threshold.
ALERT_COOLDOWN_HOURS=4
# How often the alert evaluator runs, in seconds.
ALERT_EVALUATION_INTERVAL_SECONDS=60
